# Backend REST API (shared with the buyer app — same users, same backend)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Public URL of THIS app (SEO / Open Graph)
VITE_APP_URL=https://studio.example.com

# Telegram Mini App bot handle (without @)
VITE_MINIAPP_HANDLE=your_creator_bot

# Optional: URL of the separate buyer/marketplace app. When set, the account
# menu shows an "Open the marketplace" link to it.
VITE_BUYER_APP_URL=

# Optional: JSON map of 3D environment HDR files, e.g. {"studio":"https://..."}
VITE_STUDIO_ENV_FILES={}
